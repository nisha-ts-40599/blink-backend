# Copy these into your shell or IDE run configuration.
# Prefer Render's Internal Database URL when the API also runs on Render.

# Option A — Render DATABASE_URL (postgres://user:pass@host:port/dbname)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Option B — explicit JDBC
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
# SPRING_DATASOURCE_USERNAME=USER
# SPRING_DATASOURCE_PASSWORD=PASSWORD

# Folder packed into the download zip as automation_sdlc/
BLINK_AUTOMATION_SDLC_PATH=../automation_sdlc

# Comma-separated browser origins allowed to call /api (local + Render static site)
# BLINK_CORS_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND.onrender.com
