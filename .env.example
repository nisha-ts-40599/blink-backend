# Copy this file to .env in the same folder (gitignored) and fill in real values.
# Then run: .\mvnw.cmd spring-boot:run
# You do not need $env:DATABASE_URL in PowerShell.

# Local without a database (wizard data lives in this Java process only):
SPRING_PROFILES_ACTIVE=nodb

# When you use Postgres later, remove SPRING_PROFILES_ACTIVE=nodb and set:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Folder packed into the download zip as automation_sdlc/
BLINK_AUTOMATION_SDLC_PATH=../automation_sdlc

# Cloudflare Worker (deployed agent runtime). Token is required; never commit the real value.
# Use the same string as the Worker AGENT_SERVICE_TOKEN secret.
BLINK_AGENT_RUNTIME_URL=https://blink-agent-runtime.rushikesh-kate.workers.dev
BLINK_AGENT_RUNTIME_TOKEN=

# Comma-separated browser origins allowed to call /api
# BLINK_CORS_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND.onrender.com
